---
// FAQ: sticky heading on the left (desktop), accordion on the right.
// Progressive enhancement: the server renders every answer visible. The script
// then collapses all but the first, so if JavaScript fails nothing is hidden.

// Fee and dispute details below are PLACEHOLDER DEMO POLICIES, not final terms.
const faqs = [
  {
    q: 'How and when do I get paid?',
    a: 'As soon as the maintainer merges your pull request, your payout goes out via PayPal. Most arrive within minutes. You always see the bounty amount before you start.',
  },
  {
    q: 'Can I use AI tools to write my PR?',
    a: "Yes. The review checks whether your pull request solves the issue and meets the bounty's requirements. How you write the code is up to you. Understanding the problem is what gets you merged.",
  },
  {
    q: 'How does the AI review work?',
    a: "It reads your pull request against the bounty's requirements, runs the project's tests, and flags obvious security problems. If something is missing, it tells you exactly what. The maintainer always makes the final decision to merge.",
  },
  {
    q: "What if my PR isn't merged?",
    a: "You get specific reasons, and you can push fixes as many times as you need. If your PR meets every requirement and still isn't merged, you can open a dispute and a person will review it.",
  },
  {
    q: 'Can I negotiate the bounty price?',
    a: "Yes. Every bounty shows an AI fair-price range based on the issue's complexity. If you think the work is bigger than the price, send a counter-offer before you start.",
  },
  {
    q: 'Can I work from anywhere?',
    a: 'Yes, anywhere PayPal can send payouts. Check that PayPal supports receiving money in your country before you claim a bounty.',
  },
  {
    q: 'Do I need a resume or portfolio?',
    a: 'No. Your merged pull requests are your track record, and every one is public on your profile.',
  },
  {
    q: 'What does it cost?',
    a: 'Contributors keep the full bounty. Maintainers pay a small platform fee on top, shown before they post.',
  },
];
---

<section class="faq section" id="faq" aria-labelledby="faq-title">
  <div class="faq__inner">
    <div class="faq__panel">
      <!-- Left: sticks while the questions scroll past (desktop only). -->
      <div class="faq__intro">
        <h2 class="faq__title" id="faq-title">
          <span>Questions developers ask</span>
          <span>before their first PR</span>
        </h2>
        <p class="faq__lede">Straight answers. No fine print.</p>
        <a class="faq__link" href="#">
          More answers in the Help Center
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>

      <!-- Right: accordion. Every answer starts visible (works without JS). -->
      <div class="faq__list" data-faq>
        {faqs.map((f, i) => (
          <div class="faq__item">
            <h3 class="faq__q">
              <button
                type="button"
                class="faq__button"
                id={`faq-q-${i + 1}`}
                aria-expanded="true"
                aria-controls={`faq-a-${i + 1}`}
                data-faq-button
              >
                <span class="faq__q-text">{f.q}</span>
                <span class="faq__icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"><path d="M12 5v14M5 12h14"></path></svg>
                </span>
              </button>
            </h3>
            <div class="faq__a is-open" id={`faq-a-${i + 1}`} role="region" aria-labelledby={`faq-q-${i + 1}`} data-faq-panel>
              <div class="faq__a-clip">
                <p class="faq__a-text">{f.a}</p>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- is:inline + placed right after the markup: runs while the page is still
     being parsed, so answers collapse before the first paint (no flash of all
     eight open). If it fails, every answer simply stays visible. -->
<script is:inline>
  (() => {
    const list = document.querySelector('#faq [data-faq]');
    if (!list) return;
    const buttons = [...list.querySelectorAll('[data-faq-button]')];
    const panels = buttons.map((b) => document.getElementById(b.getAttribute('aria-controls')));

    // Open or close item i. Closed panels are inert: not focusable, not read out.
    const setOpen = (i, open) => {
      buttons[i].setAttribute('aria-expanded', String(open));
      panels[i].classList.toggle('is-open', open);
      panels[i].inert = !open;
    };

    // Enhance: from here on the collapsing styles apply. Start with item 1 open.
    // .is-instant skips the animation for this first setup.
    list.classList.add('is-enhanced', 'is-instant');
    buttons.forEach((_, i) => setOpen(i, i === 0));
    requestAnimationFrame(() => requestAnimationFrame(() => list.classList.remove('is-instant')));

    // Each item toggles on its own; several can be open at once.
    buttons.forEach((b, i) =>
      b.addEventListener('click', () => setOpen(i, b.getAttribute('aria-expanded') !== 'true')),
    );
  })();
</script>

<style>
  .faq {
    --section-bg: var(--surface);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    padding-block: clamp(64px, 10vw, 128px);
    color: var(--ink);
  }

  .faq__inner {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--content-pad);
  }

  /* No overflow on the panel or section: overflow other than visible/clip
     on an ancestor would stop position: sticky from working. */
  .faq__panel {
    display: grid;
    gap: 40px;
    align-items: start;
    padding: 24px;
    border-radius: 24px;
    background: var(--canvas);
  }

  @media (min-width: 1024px) {
    .faq__panel {
      grid-template-columns: minmax(0, 40fr) minmax(0, 60fr);
      gap: clamp(40px, 5vw, 80px);
      padding: 72px;
      border-radius: 32px;
    }
  }

  @media (min-width: 768px) and (max-width: 1023.98px) {
    .faq__panel { padding: 48px; border-radius: 28px; }
  }

  /* ---------- Left: heading block ---------- */
  .faq__title {
    font-weight: 600;
    color: var(--ink);
  }

  .faq__title span { display: block; }

  .faq__lede {
    margin-top: 16px;
    font-size: 1.0625rem;
    color: var(--ink-muted);
  }

  .faq__link {
    margin-top: 24px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding-bottom: 3px;
    border-bottom: 1.5px solid currentColor;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .faq__link:hover { color: var(--merged); }

  /* Desktop: the heading block sticks 96px from the top while its grid cell
     (as tall as the accordion) scrolls past, then leaves with the panel. */
  @media (min-width: 1024px) {
    .faq__intro {
      position: sticky;
      top: calc(var(--header-height) + 24px); /* just below the sticky site header */
      align-self: start;
    }
  }

  /* ---------- Right: accordion ---------- */
  .faq__list { border-top: 1px solid var(--line); }

  .faq__item { border-bottom: 1px solid var(--line); }

  .faq__q {
    margin: 0;
    font: inherit;
  }

  .faq__button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 0;
    border: 0;
    background: none;
    text-align: left;
    color: var(--ink);
  }

  @media (min-width: 1024px) {
    .faq__button { padding-block: 28px; }
  }

  .faq__button:focus-visible {
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .faq__q-text {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.25;
  }

  @media (min-width: 1024px) {
    .faq__q-text { font-size: 1.5rem; }
  }

  .faq__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--ink-muted);
    border-radius: var(--radius-sm);
    color: var(--ink);
    transition: border-color 200ms var(--ease);
  }

  .faq__icon svg { transition: transform 350ms var(--ease); }

  .faq__button:hover .faq__icon,
  .faq__button:focus-visible .faq__icon { border-color: var(--merged); }

  /* Plus turns into an X when the item is open. */
  .faq__button[aria-expanded='true'] .faq__icon svg { transform: rotate(45deg); }

  /* ---------- Answer ---------- */
  .faq__a {
    display: grid;
    grid-template-rows: 1fr; /* open by default: the no-JS state */
  }

  .faq__a-clip {
    min-height: 0;
    overflow: hidden; /* clips only the answer text while its row is shorter than it */
  }

  .faq__a-text {
    max-width: 38rem;
    padding-bottom: 24px;
    line-height: 1.65;
    color: var(--ink-muted);
  }

  @media (min-width: 1024px) {
    .faq__a-text { padding-bottom: 28px; }
  }

  /* Enhanced (JS ran): closed answers collapse to a 0fr row, open ones grow
     to 1fr. The text fades in slightly after the height starts opening. */
  .is-enhanced .faq__a {
    grid-template-rows: 0fr;
    visibility: hidden;
    transition: grid-template-rows 350ms var(--ease), visibility 0s linear 350ms;
  }

  .is-enhanced .faq__a.is-open {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows 350ms var(--ease), visibility 0s;
  }

  .is-enhanced .faq__a-text {
    opacity: 0;
    transition: opacity 200ms var(--ease);
  }

  .is-enhanced .faq__a.is-open .faq__a-text {
    opacity: 1;
    transition: opacity 300ms var(--ease) 100ms;
  }

  .is-instant *,
  .is-instant *::before { transition: none !important; }
</style>
