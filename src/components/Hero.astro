---
// Hero: the core promise, both CTAs, the flat hero image (PR card, shapes and
// stat cards baked in; built by src/dev/hero-image.astro + npm run export:hero),
// and a contributor testimonial carousel.

const testimonials = [
  {
    quote: 'Fixed a flaky gripper test in the robot sim on a Friday night. The payout hit PayPal before I closed my laptop.',
    name: 'Amara O.',
    meta: 'Nigeria · Robotics, C++',
  },
  {
    quote: 'The AI review told me exactly what my telemetry decoder was missing before the maintainer even looked. Second push got merged.',
    name: 'Lucas M.',
    meta: 'Brazil · Space, Go',
  },
  {
    quote: 'We cleared 30 agent-tooling issues in a month without hiring. Contributors get paid, we ship.',
    name: 'Priya S.',
    meta: 'India · Maintainer, open-source agent framework',
  },
];

---

<section class="hero section" aria-labelledby="hero-title">
  <div class="hero__inner">
    <!-- Left column: promise + CTAs -->
    <div class="hero__copy">
      <h1 class="hero__title" id="hero-title">Get paid the moment your code merges.</h1>

      <p class="hero__lede">
        Pick an open bounty in robotics, space or AI agents, ship a pull request, and our AI reviews
        it against the brief. Once it's merged, your payout goes out via PayPal, wherever you are.
      </p>

      <div class="hero__ctas">
        <a class="btn btn--primary" href="#bounties">
          Find a bounty
          <svg class="btn__arrow" viewBox="0 0 20 20" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg>
        </a>
        <a class="btn btn--secondary" href="#paths">Post a bounty</a>
      </div>
    </div>

    <!-- Right column: flat hero image. The browser picks the mobile or desktop
         file from the <source> media query. Stats are part of the image, so
         they are spelled out in the alt text. -->
    <div class="hero__visual">
      <picture class="hero-picture">
        <source media="(max-width: 767px)" srcset="/images/hero-image-mobile.webp" width="936" height="893" />
        <img
          src="/images/hero-image-desktop.webp"
          width="1200"
          height="1140"
          alt="A pull request marked Merged after passing AI review, with a $900 payout sent via PayPal. Stats: 40+ languages, about 5 minutes from merge to payout, $250 average bounty."
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>

    <!-- Left column (desktop): testimonial carousel -->
    <div
      class="quote"
      role="region"
      aria-roledescription="carousel"
      aria-label="What contributors and maintainers say"
      data-carousel
    >
      <div class="quote__slides" aria-live="off" data-slides>
        {testimonials.map((t, i) => (
          <figure
            class:list={['quote__slide', { 'is-active': i === 0 }]}
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${testimonials.length}`}
            aria-hidden={i === 0 ? 'false' : 'true'}
            data-slide
          >
            <blockquote class="quote__text">
              <p>“{t.quote}”</p>
            </blockquote>
            <figcaption class="quote__person">
              <span class="avatar avatar--lg" aria-hidden="true">{t.name.charAt(0)}</span>
              <span>
                <span class="quote__name">{t.name}</span>
                <span class="quote__meta">{t.meta}</span>
              </span>
            </figcaption>
          </figure>
        ))}
      </div>

      <div class="quote__controls" data-controls hidden>
        <button class="quote__toggle" type="button" aria-pressed="false" aria-label="Pause testimonials" data-toggle>
          <svg class="icon-pause" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
            <path d="M5.5 3.5v9M10.5 3.5v9" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
          <svg class="icon-play" viewBox="0 0 16 16" width="14" height="14" aria-hidden="true" focusable="false">
            <path d="M5 3.2v9.6L12.5 8z" fill="currentColor"></path>
          </svg>
        </button>
        <div class="quote__dots">
          {testimonials.map((t, i) => (
            <button
              class="quote__dot"
              type="button"
              aria-label={`Show testimonial ${i + 1} of ${testimonials.length}: ${t.name}`}
              aria-current={i === 0 ? 'true' : undefined}
              data-dot
            ></button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Testimonial carousel: auto-rotates every 6s; pauses on hover, on focus
  // within, when the user presses Pause, when the tab is hidden, or when the
  // card is hidden (mobile). Starts paused under prefers-reduced-motion.
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');

  if (carousel) {
    const INTERVAL = 6000;
    const slides = [...carousel.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const toggle = carousel.querySelector<HTMLButtonElement>('[data-toggle]')!;
    const live = carousel.querySelector<HTMLElement>('[data-slides]')!;
    const controls = carousel.querySelector<HTMLElement>('[data-controls]')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const desktop = window.matchMedia('(min-width: 900px)');

    let index = 0;
    let timer: number | undefined;
    let userPaused = reduceMotion.matches;
    let hovering = false;
    let focusWithin = false;

    controls.hidden = false;

    const show = (i: number) => {
      index = (i + slides.length) % slides.length;
      slides.forEach((slide, n) => {
        const active = n === index;
        slide.classList.toggle('is-active', active);
        slide.setAttribute('aria-hidden', String(!active));
      });
      dots.forEach((dot, n) => {
        if (n === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
    };

    const isRotating = () =>
      !userPaused && !hovering && !focusWithin && !document.hidden && desktop.matches;

    // Re-evaluate every time something changes: (re)start or stop the timer.
    const sync = () => {
      window.clearInterval(timer);
      timer = isRotating() ? window.setInterval(() => show(index + 1), INTERVAL) : undefined;
      toggle.setAttribute('aria-pressed', String(userPaused));
      // Only announce slide changes the user caused, never automatic ones.
      live.setAttribute('aria-live', isRotating() ? 'off' : 'polite');
    };

    toggle.addEventListener('click', () => {
      userPaused = !userPaused;
      // Pressing Play is an explicit request, so it overrides the focus pause.
      if (!userPaused) focusWithin = false;
      sync();
    });

    dots.forEach((dot, n) =>
      dot.addEventListener('click', () => {
        show(n);
        sync();
      }),
    );

    carousel.addEventListener('mouseenter', () => { hovering = true; sync(); });
    carousel.addEventListener('mouseleave', () => { hovering = false; sync(); });
    carousel.addEventListener('focusin', () => { focusWithin = true; sync(); });
    carousel.addEventListener('focusout', (e) => {
      if (!carousel.contains(e.relatedTarget as Node | null)) {
        focusWithin = false;
        sync();
      }
    });
    document.addEventListener('visibilitychange', sync);
    desktop.addEventListener('change', sync);
    reduceMotion.addEventListener('change', () => {
      if (reduceMotion.matches) userPaused = true;
      sync();
    });

    show(0);
    sync();
  }
</script>

<style>
  /* ---------- Section + grid (mobile first) ---------- */
  .hero {
    --section-bg: var(--canvas);
    position: relative;
    overflow: clip;
    min-height: calc(100vh - var(--header-height));
    min-height: calc(100dvh - var(--header-height));
    display: flex;
    align-items: center;
    padding-block: clamp(40px, 7vw, 88px);
  }

  .hero__inner {
    width: 100%;
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--content-pad);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'copy'
      'visual'
      'quote';
    row-gap: clamp(40px, 8vw, 56px);
  }

  .hero__copy { grid-area: copy; }
  .hero__visual { grid-area: visual; position: relative; }
  .quote { grid-area: quote; }

  @media (min-width: 900px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      grid-template-rows: auto auto;
      grid-template-areas:
        'copy visual'
        'quote visual';
      column-gap: clamp(32px, 5vw, 80px);
      row-gap: 32px;
      align-content: center;
    }

    .hero__visual { align-self: center; }
  }

  /* ---------- Copy ---------- */
  .hero__title {
    font-size: clamp(2rem, 1.2rem + 4vw, 4.75rem);
    line-height: 1.05;
    max-width: 14ch;
    color: var(--ink);
  }


  .hero__lede {
    margin-top: clamp(16px, 2.5vw, 24px);
    max-width: 38rem;
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.25rem);
    color: var(--ink-muted);
  }

  .hero__ctas {
    margin-top: clamp(24px, 3.5vw, 36px);
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Desktop: fit the whole hero (incl. testimonial card) in one screen.
     Sizes follow the smaller of width and height, so short laptops shrink too.
     Placed after the base copy rules so these win on source order. */
  @media (min-width: 900px) {
    .hero {
      min-height: calc(100svh - var(--header-height));
      padding-block: clamp(20px, 4.5svh, 64px);
    }

    .hero__inner { row-gap: clamp(20px, 4svh, 40px); }

    .hero__title {
      font-size: clamp(2.5rem, min(4.6vw, 8.4svh), 4.5rem);
      line-height: 1.02;
    }

    .hero__lede { margin-top: clamp(12px, 2.4svh, 24px); }
    .hero__ctas { margin-top: clamp(18px, 3.6svh, 36px); }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    padding: 0 24px;
    border-radius: var(--radius-sm);
    font-weight: 600;
    font-size: 1rem;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  .btn--primary {
    background: var(--merged);
    color: var(--surface);
  }

  .btn--primary:hover {
    background: var(--merged-hover);
    color: var(--surface);
  }

  .btn__arrow { transition: transform 160ms ease; }
  .btn--primary:hover .btn__arrow { transform: translateX(3px); }

  .btn--secondary {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--ink);
  }

  .btn--secondary:hover {
    background: var(--ink);
    color: var(--surface);
  }

  @media (max-width: 479.98px) {
    .hero__ctas { flex-direction: column; }
    .btn { width: 100%; }
  }

  /* One-time load reveal for the copy (under 0.6s total). */
  @media (prefers-reduced-motion: no-preference) {
    .hero__title,
    .hero__lede,
    .hero__ctas {
      animation: hero-rise 420ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
    }
    .hero__lede { animation-delay: 80ms; }
    .hero__ctas { animation-delay: 160ms; }
  }

  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* ---------- Visual: one flat image ---------- */
  .hero__visual {
    display: flex;
    justify-content: center;
  }

  .hero-picture {
    display: block;
    width: min(100%, 640px);
  }

  /* width/height attributes give the aspect ratio up front (no layout shift);
     height: auto lets it scale with the width. */
  .hero-picture img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- Testimonial carousel ---------- */
  .quote {
    display: none;
    max-width: 34rem;
    padding: 20px 22px 16px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 900px) {
    .quote { display: block; }
  }

  /* All slides share one grid cell so the card keeps the tallest slide's height. */
  .quote__slides { display: grid; }

  .quote__slide {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    transition: opacity 400ms ease, visibility 0s linear 400ms;
  }

  .quote__slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 400ms ease, visibility 0s;
  }

  .quote__text {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink);
  }

  .quote__person {
    margin-top: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--merged-tint);
    color: var(--merged);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .avatar--lg {
    width: 36px;
    height: 36px;
    font-size: 0.9375rem;
  }

  .quote__name {
    display: block;
    font-weight: 600;
    font-size: 0.9375rem;
    line-height: 1.3;
    color: var(--ink);
  }

  .quote__meta {
    display: block;
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }

  .quote__controls {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .quote__controls[hidden] { display: none; }

  .quote__toggle {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface);
    color: var(--ink);
  }

  .quote__toggle:hover { background: var(--canvas); }
  .quote__toggle .icon-play { display: none; }
  .quote__toggle[aria-pressed='true'] .icon-play { display: block; }
  .quote__toggle[aria-pressed='true'] .icon-pause { display: none; }

  .quote__dots {
    display: flex;
    gap: 2px;
  }

  .quote__dot {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
  }

  .quote__dot::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--ink-muted);
    transition: width 200ms ease, background-color 200ms ease;
  }

  .quote__dot[aria-current='true']::before {
    width: 20px;
    background: var(--merged);
  }
</style>
