---
// Paths: contributor (Earn), learner (Grow) and maintainer (Ship) paths.
//
// Three layouts from one set of markup:
//  - Desktop (>= 1024px) with JS and motion allowed: `.is-pinned`. The section is
//    300vh tall; a sticky wrapper holds the grid while scroll drives the active path.
//  - Desktop with reduced motion (or no JS): the three paths stacked as static rows.
//  - Below 1024px: one media card above a scroll-snap carousel of content cards.

const paths = [
  {
    key: 'earn',
    num: '01',
    label: 'Earn',
    caption: 'Earning on merge.',
    sub: 'Paid bounties',
    summary: 'Example payout history: three merged pull requests paid $400, $150 and $900 via PayPal.',
    quote: "I pick up robotics bounties between client projects. It's the most predictable income I have.",
    who: 'Kenji T. · Japan · Robotics, C++',
    body: 'You already know how to ship. Earn turns your skills into a payout for every merged pull request. No proposals, no invoices, no chasing clients.',
  },
  {
    key: 'grow',
    num: '02',
    label: 'Grow',
    caption: 'Learning in public.',
    sub: 'Portfolio-building bounties',
    summary: 'Example AI review on a small fix to a robot’s obstacle avoidance, asking for one more test before the bounty requirements are met.',
    quote: 'Every AI review taught me something. Six months of merged simulation tests got me my first robotics job.',
    who: 'Sofia R. · Mexico · Robotics, Python',
    body: 'Start with beginner-friendly bounties and get AI feedback on every pull request. Build a public record of merged work that hiring managers can actually check.',
  },
  {
    key: 'ship',
    num: '03',
    label: 'Ship',
    caption: 'Clearing the backlog.',
    sub: 'For maintainers and startups',
    summary: 'Example bounty for adding timeouts to AI agent tool calls: AI suggested $280 to $360, it was posted at $320, and a contributor countered at $340.',
    quote: 'The AI suggested a fair price, a contributor countered, and the fix shipped in two days.',
    who: 'Daniel K. · Germany · CTO, AI agents startup',
    body: 'Review one verified pull request, not ten. Each bounty goes to one contributor at a time, AI checks their PR against your brief and tests before you look, and payouts go out via PayPal only when you merge.',
  },
];

const payouts = [
  { pr: 'PR #512 merged', amount: '+$400.00' },
  { pr: 'PR #498 merged', amount: '+$150.00' },
  { pr: 'PR #476 merged', amount: '+$900.00' },
];

const diff = [
  { type: 'ctx', code: 'scan = lidar.latest()' },
  { type: 'add', code: 'if scan is None:' },
  { type: 'add', code: '    return Stop()' },
  { type: 'ctx', code: 'return plan_path(scan)' },
];

const total = String(paths.length).padStart(2, '0');
---

<section class="paths section section--dark" id="paths" aria-labelledby="paths-title" data-paths data-active="0">
  <div class="paths__pin">
    <div class="paths__grid">
      <div class="paths__intro">
        <h2 class="paths__title" id="paths-title">
          <span>One platform.</span>
          <span>Three paths.</span>
        </h2>
        <p class="paths__lede">
          Pick the one that fits where you are. Every path ends with merged code and a fair payout.
        </p>
      </div>

      <!-- Row backgrounds: only used in the static (stacked) desktop layout. -->
      <div class="paths__bgs" aria-hidden="true">
        {paths.map((p, i) => (
          <div class={`paths__rowbg paths__rowbg--${p.key}`} style={`--row: ${i + 2}`}></div>
        ))}
      </div>

      <!-- Middle column: media cards (vignettes are decorative; each has a text summary). -->
      <div class="paths__media">
        {paths.map((p, i) => (
          <div class:list={['media', { 'is-active': i === 0 }]} style={`--row: ${i + 2}`} data-media>
            <p class="visually-hidden">{p.summary}</p>
            <div class="media__stage" aria-hidden="true">
              {p.key === 'earn' && (
                <div class="vig">
                  <div class="vig__head">
                    <span>Payout history</span>
                    <span class="vig__tag">via PayPal</span>
                  </div>
                  <ul class="vig__rows">
                    {payouts.map((row) => (
                      <li class="vig__row">
                        <span class="vig__pr">{row.pr}</span>
                        <span class="vig__amount">{row.amount}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {p.key === 'grow' && (
                <div class="vig">
                  <div class="vig__head vig__head--code">
                    <span>nav/avoid.py</span>
                    <span class="vig__plus">+2</span>
                  </div>
                  <div class="vig__diff">
                    {diff.map((line) => (
                      <div class:list={['vig__line', { 'vig__line--add': line.type === 'add' }]}>
                        <span class="vig__sign">{line.type === 'add' ? '+' : ' '}</span>
                        <span>{line.code}</span>
                      </div>
                    ))}
                  </div>
                  <div class="vig__bubble">
                    <span class="vig__bubble-label">AI review</span>
                    <p>Nice fix. Add a test for the dropped-frame case and this meets the bounty.</p>
                  </div>
                </div>
              )}
              {p.key === 'ship' && (
                <div class="vig">
                  <p class="vig__title">Add timeouts to agent tool calls</p>
                  <p class="vig__ai">
                    AI suggested price: <strong>$280–$360</strong> based on complexity
                  </p>
                  <div class="vig__posted">
                    <span>Bounty posted</span>
                    <strong>$320</strong>
                  </div>
                  <div class="vig__counter">
                    <span class="vig__avatar">A</span>
                    <span class="vig__counter-text"><b>amara-o</b> countered $340</span>
                    <span class="vig__chips">
                      <span class="vig__chip vig__chip--accept">Accept</span>
                      <span class="vig__chip">Decline</span>
                    </span>
                  </div>
                </div>
              )}
            </div>
            <div class="media__text">
              <p class="media__caption">{p.caption}</p>
              <p class="media__sub">{p.sub}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Right column: content cards. On tablet/mobile this is the swipeable carousel.
           Testimonials below are SAMPLE DEMO CONTENT, not real customers. -->
      <div
        class="paths__track"
        role="region"
        aria-roledescription="carousel"
        aria-label="Fairmerge paths"
        data-track
      >
        {paths.map((p, i) => (
          <article
            class:list={['pcard', { 'is-active': i === 0 }]}
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${paths.length}: ${p.label}`}
            style={`--row: ${i + 2}`}
            data-card
            data-label={p.label}
          >
            <div class="pcard__meta anim" style="--d: 0ms">
              <span class="pcard__num">{p.num}</span>
              <span class="pcard__line" aria-hidden="true"></span>
              <span class="pcard__label">{p.label}</span>
            </div>
            <h3 class="pcard__title anim" style="--d: 80ms">{p.label}</h3>
            <blockquote class="pcard__quote anim" style="--d: 160ms">
              <svg class="pcard__mark" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M4 18v-5.5C4 8.4 6.4 6 10 5.5V8c-2 .5-3 1.8-3 4h3v6H4zm10 0v-5.5c0-4.1 2.4-6.5 6-7V8c-2 .5-3 1.8-3 4h3v6h-6z"></path>
              </svg>
              <p>{p.quote}</p>
            </blockquote>
            <p class="pcard__who anim" style="--d: 220ms">{p.who}</p>
            <p class="pcard__body anim" style="--d: 300ms">{p.body}</p>
          </article>
        ))}
      </div>

      <div class="paths__controls" data-controls hidden>
        <button class="paths__btn" type="button" aria-label="Previous path" disabled data-prev>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 6l-6 6 6 6"></path></svg>
        </button>
        <!-- Segment buttons are rendered here by the shared carousel script. -->
        <div class="paths__segs" data-segs></div>
        <p class="paths__counter" aria-hidden="true">
          <span data-counter>01</span> / {total}
        </p>
        <button class="paths__btn" type="button" aria-label="Next path" data-next>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 6l6 6-6 6"></path></svg>
        </button>
      </div>

      <p class="visually-hidden" aria-live="polite" data-live></p>
    </div>
  </div>
</section>

<script>
  import { createCarousel } from '../scripts/carousel.js';

  const section = document.querySelector<HTMLElement>('[data-paths]');

  if (section) {
    const track = section.querySelector<HTMLElement>('[data-track]')!;
    const cards = [...section.querySelectorAll<HTMLElement>('[data-card]')];
    const medias = [...section.querySelectorAll<HTMLElement>('[data-media]')];
    const counter = section.querySelector<HTMLElement>('[data-counter]')!;
    const controls = section.querySelector<HTMLElement>('[data-controls]')!;

    const wide = window.matchMedia('(min-width: 1024px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const count = cards.length;
    let active = -1;

    type Mode = 'pinned' | 'static' | 'carousel';
    const mode = (): Mode => (wide.matches ? (reduceMotion.matches ? 'static' : 'pinned') : 'carousel');

    // ---------- Shared: show path i (background, media card, content card, counter) ----------
    const setActive = (i: number) => {
      if (i === active) return;
      active = i;
      section.dataset.active = String(i); // drives the background color in CSS
      cards.forEach((c, n) => c.classList.toggle('is-active', n === i));
      medias.forEach((m, n) => m.classList.toggle('is-active', n === i));
      counter.textContent = String(i + 1).padStart(2, '0');
    };

    // ---------- Desktop: scroll position -> active path + progress ----------
    let ticking = false;
    const update = () => {
      ticking = false;
      // The pin sits just below the sticky site header, so the visible area
      // (and the scroll distance while pinned) is the viewport minus the header.
      const header = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 0;
      const range = section.offsetHeight - (window.innerHeight - header); // the scroll distance while pinned
      const scrolled = header - section.getBoundingClientRect().top;
      const p = Math.min(Math.max(scrolled / range, 0), 1); // 0..1 across the whole section
      const scaled = p * count; // 0..3
      const i = Math.min(count - 1, Math.floor(scaled));
      setActive(i);
      section.style.setProperty('--progress', Math.min(scaled - i, 1).toFixed(4));
    };
    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    };

    // ---------- Tablet/mobile: the shared carousel (one card per page) ----------
    const carousel = createCarousel({
      track,
      slides: cards,
      prev: section.querySelector<HTMLButtonElement>('[data-prev]')!,
      next: section.querySelector<HTMLButtonElement>('[data-next]')!,
      indicators: section.querySelector<HTMLElement>('[data-segs]')!,
      indicatorClass: 'paths__seg',
      indicatorLabel: (page) => `Go to path ${page + 1}: ${cards[page].dataset.label}`,
      perPage: { 0: 1 },
      live: section.querySelector<HTMLElement>('[data-live]')!,
      announce: ({ first }) => `Path ${first + 1} of ${count}: ${cards[first].dataset.label}`,
      onChange: ({ first }) => setActive(first),
      isEnabled: () => mode() === 'carousel',
    });

    // ---------- Switch layouts when the viewport or motion setting changes ----------
    const applyMode = () => {
      const m = mode();
      section.classList.toggle('is-pinned', m === 'pinned');
      window.removeEventListener('scroll', onScroll);
      window.removeEventListener('resize', onScroll);
      controls.hidden = m !== 'carousel';

      if (m === 'carousel') track.tabIndex = 0;
      else track.removeAttribute('tabindex');

      if (m === 'pinned') {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        update();
      } else {
        section.style.removeProperty('--progress');
        if (m === 'carousel') {
          active = -1;
          carousel.reset(); // first card, segments rebuilt, buttons updated
        } else {
          setActive(0);
        }
      }
    };

    applyMode();
    wide.addEventListener('change', applyMode);
    reduceMotion.addEventListener('change', applyMode);
  }
</script>

<style>
  /* ==========================================================================
     Base = tablet/mobile carousel layout (< 1024px)
     ========================================================================== */
  .paths {
    --path-bg: var(--path-earn-bg);
    --edge: max(var(--content-pad), calc((100% - var(--content-width)) / 2 + var(--content-pad)));
    position: relative;
    --section-bg: var(--path-bg);
    padding-block: var(--section-pad);
    color: var(--surface);
    transition: background-color var(--dur-slower) var(--ease-out);
  }

  .paths[data-active='1'] { --path-bg: var(--path-grow-bg); }
  .paths[data-active='2'] { --path-bg: var(--path-ship-bg); }

  .paths__grid {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--content-pad);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(var(--space-6), 5vw, var(--space-7));
  }

  /* ---------- Intro ---------- */
  .paths__title {
    color: var(--surface);
    font-weight: 600;
  }

  .paths__title span { display: block; }

  .paths__lede {
    margin-top: var(--space-4);
    max-width: var(--measure-narrow);
    font-size: var(--text-body-lg);
    color: var(--on-dark-muted);
  }

  .paths__bgs { display: none; }

  /* ---------- Media cards (stacked; only the active one shows) ---------- */
  .paths__media { display: grid; }

  .media {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: clamp(var(--space-4), 2vw, var(--space-5));
    background: var(--on-dark-surface);
    border: 1px solid var(--on-dark-line);
    border-radius: var(--radius-lg);
    transition: opacity var(--dur-slow) var(--ease-out);
  }

  .media:not(.is-active) {
    opacity: 0;
    pointer-events: none;
  }

  .media__stage {
    flex: 1;
    display: grid;
    align-items: center;
    transition:
      opacity var(--dur-slow) var(--ease-out),
      transform var(--dur-slower) var(--ease-out),
      clip-path var(--dur-slower) var(--ease-out);
    clip-path: inset(0 0 0 0 round 12px);
  }

  .media:not(.is-active) .media__stage {
    opacity: 0;
    transform: scale(0.96);
    clip-path: inset(0 0 100% 0 round 12px);
  }

  .media__caption,
  .media__sub {
    transition: opacity var(--dur-slow) var(--ease-out), transform var(--dur-slow) var(--ease-out);
  }

  .media.is-active .media__caption { transition-delay: 250ms; }
  .media.is-active .media__sub { transition-delay: 370ms; }

  .media:not(.is-active) .media__caption,
  .media:not(.is-active) .media__sub {
    opacity: 0;
    transform: translateY(10px);
  }

  .media__caption {
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 500;
    line-height: var(--leading-snug);
    color: var(--surface);
  }

  .media__sub {
    margin-top: var(--space-1);
    font-size: var(--text-small);
    color: var(--on-dark-muted);
  }

  /* ---------- Vignettes: small light "app" panels ---------- */
  .vig {
    padding: var(--space-3) var(--space-4);
    background: var(--surface);
    border-radius: var(--radius-md);
    color: var(--ink);
    font-size: var(--text-small);
    box-shadow: var(--shadow-lg);
  }

  .vig__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--line);
    font-weight: 600;
  }

  .vig__head--code {
    font-family: var(--font-code);
    font-weight: 500;
    font-size: var(--text-caption);
    color: var(--ink-muted);
  }

  .vig__tag {
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
    background: var(--canvas);
    font-size: var(--text-caption);
    font-weight: 500;
    color: var(--ink-muted);
  }

  .vig__plus { color: var(--payout); }

  .vig__rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .vig__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--line);
  }

  .vig__row:last-child { border-bottom: 0; padding-bottom: 0; }

  .vig__pr { color: var(--ink-muted); }

  .vig__amount {
    font-variant-numeric: tabular-nums;
    font-weight: 600;
    color: var(--payout);
  }

  .vig__diff {
    margin-top: var(--space-2);
    font-family: var(--font-code);
    font-size: var(--text-caption);
    line-height: var(--leading-code);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .vig__line {
    display: grid;
    grid-template-columns: 1.6em minmax(0, 1fr);
    padding-right: var(--space-2);
    white-space: pre;
  }

  .vig__line > span:last-child { overflow: hidden; }
  .vig__sign { text-align: center; color: var(--ink-muted); }
  .vig__line--add { background: var(--payout-tint); }
  .vig__line--add .vig__sign { color: var(--payout); }

  .vig__bubble {
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    background: var(--brand-tint);
    font-size: var(--text-caption);
    line-height: var(--leading-normal);
  }

  .vig__bubble-label {
    display: block;
    margin-bottom: 2px;
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--brand);
  }

  .vig__title {
    font-family: var(--font-display);
    font-size: var(--text-body);
    font-weight: 600;
  }

  .vig__ai {
    margin-top: var(--space-2);
    padding: var(--space-2) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--brand-tint);
    font-size: var(--text-caption);
    color: var(--ink);
  }

  .vig__ai strong { color: var(--brand); }

  .vig__posted {
    margin-top: var(--space-2);
    display: flex;
    justify-content: space-between;
    padding-block: var(--space-2);
    border-block: 1px solid var(--line);
    color: var(--ink-muted);
  }

  .vig__posted strong {
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .vig__counter {
    margin-top: var(--space-2);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-caption);
  }

  .vig__avatar {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--brand-tint);
    color: var(--brand);
    font-size: var(--text-caption);
    font-weight: 700;
  }

  .vig__counter-text b {
    font-family: var(--font-code);
    font-weight: 500;
  }

  .vig__chips {
    margin-left: auto;
    display: flex;
    gap: var(--space-2);
  }

  .vig__chip {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-pill);
    border: 1px solid var(--line);
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--ink-muted);
  }

  .vig__chip--accept {
    border-color: transparent;
    background: var(--payout-tint);
    color: var(--payout);
  }

  /* ---------- Content cards: carousel by default ---------- */
  .paths__track {
    position: relative;
    display: flex;
    gap: var(--space-3);
    margin-inline: calc(-1 * var(--content-pad));
    padding: var(--space-1) var(--content-pad);
    scroll-padding-inline: var(--content-pad);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .paths__track::-webkit-scrollbar { display: none; }

  .paths__track:focus-visible {
    outline: 3px solid var(--focus-ring-on-dark);
    outline-offset: -3px;
    border-radius: var(--radius-sm);
  }

  @media (hover: hover) and (pointer: fine) {
    .paths__track[tabindex] { cursor: grab; }
    .paths__track.is-dragging {
      cursor: grabbing;
      user-select: none;
      scroll-snap-type: none;
    }
  }

  .pcard {
    flex: 0 0 min(86%, 440px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    padding: clamp(var(--space-5), 2.4vw, var(--space-6));
    background: var(--on-dark-surface);
    border: 1px solid var(--on-dark-line);
    border-radius: var(--radius-lg);
  }

  .pcard__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--on-dark-line);
    font-size: var(--text-small);
  }

  .pcard__num {
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    color: var(--surface);
  }

  .pcard__label { color: var(--surface); }

  /* The thin line: a track with a white fill that can grow (scaleX) as a progress bar. */
  .pcard__line {
    position: relative;
    flex: 1;
    height: 1px;
    overflow: hidden;
    background: var(--on-dark-line);
  }

  .pcard__line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--surface);
    transform-origin: left center;
    transform: scaleX(1);
  }

  .pcard__title {
    margin-top: var(--space-5);
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 400;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--surface);
  }

  .pcard__quote {
    margin-top: var(--space-5);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    font-size: var(--text-body-lg);
    line-height: var(--leading-normal);
    color: var(--surface);
  }

  /* Light violet: reads on all three path backgrounds (--brand was ~1.9:1). */
  .pcard__mark { color: var(--brand-tint); margin-top: 2px; }

  .pcard__who {
    margin-top: var(--space-2);
    padding-left: var(--space-6);
    padding-bottom: var(--space-5);
