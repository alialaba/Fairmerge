---
// WaysToEarn: the five bounty types.
//  - Desktop (>= 1024px): vertical tabs on the left, the active panel on the right.
//  - Below 1024px: the same items as an accordion, each panel under its header.
// One set of elements; the script switches the ARIA pattern (tabs vs accordion)
// with a matchMedia listener. One item is always open and can't be closed.
import Icon from './ui/Icon.astro';

const items = [
  {
    id: 'bugs',
    label: 'Fix bugs',
    icon: 'bug',
    title: 'Find it. Fix it. Get paid.',
    description:
      "Track down what's broken and ship the fix. If you've seen the problem before, you can be merged and paid the same day.",
    chips: ['Race conditions', 'Memory leaks', 'Edge cases', 'Regressions'],
    cta: 'View bug-fix bounties',
    visual: 'diff',
  },
  {
    id: 'features',
    label: 'Build features',
    icon: 'feature',
    title: 'From brief to merged code.',
    description:
      'Take a well-scoped issue from idea to merged code. The brief tells you exactly what done looks like, and the AI review checks against it.',
    chips: ['API endpoints', 'UI components', 'Integrations', 'CLI commands'],
    cta: 'View feature bounties',
    visual: 'pr',
  },
  {
    id: 'tests',
    label: 'Write tests',
    icon: 'test',
    title: 'Cover what nobody covered.',
    description:
      "Cover the cases nobody else got to. A great starting point if you're new to a codebase.",
    chips: ['Unit tests', 'Integration tests', 'Edge cases', 'Flaky test fixes'],
    cta: 'View testing bounties',
    visual: 'tests',
  },
  {
    id: 'docs',
    label: 'Improve docs',
    icon: 'docs',
    title: 'Make the code make sense.',
    description:
      "Explain what the code does so the next developer doesn't have to guess. Clear writing gets merged fast.",
    chips: ['Migration guides', 'API reference', 'Tutorials', 'READMEs'],
    cta: 'View docs bounties',
    visual: 'doc',
  },
  {
    id: 'reviews',
    label: 'Review code',
    icon: 'review',
    title: 'Catch what others miss.',
    description:
      'Specialists in security, accessibility, databases, or performance catch what general reviews miss. Get paid for the expertise, not the typing.',
    chips: ['Security', 'Accessibility', 'Performance', 'Database design'],
    cta: 'View review bounties',
    visual: 'review',
  },
] as const;

const langs = ['TypeScript', 'Python', 'Rust', 'Go', 'JavaScript', 'Java', 'Ruby', 'PHP'];

// SAMPLE DEMO CONTENT for the decorative vignettes (fictional repos and code).
const diff = [
  { type: 'del', code: 'state = sim.read_gripper()' },
  { type: 'del', code: 'sim.step()' },
  { type: 'add', code: 'with sim.lock:' },
  { type: 'add', code: '    sim.step()' },
  { type: 'add', code: '    state = sim.read_gripper()' },
];
const testRuns = ['glass_wall_detected', 'pedestrian_crossing', 'dropped_lidar_frame', 'empty_scan_stops'];
---

<section class="ways section" id="ways-to-earn" aria-labelledby="ways-title" data-ways>
  <div class="ways__inner">
    <header class="ways__head">
      <h2 class="ways__heading-main" id="ways-title">
        <span>Five ways</span>
        <span>to earn.</span>
      </h2>
      <div class="ways__intro">
        <p>
          Every bounty falls into one of five types. Bring the expertise you already have, and use
          whatever tools you like, AI included.
        </p>
        <a class="ways__browse" href="#bounties">
          Browse all bounties
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
    </header>

    <!-- Tabs on desktop / accordion below 1024px. Server markup is the accordion
         order (each panel right after its header); on desktop the script moves the
         panels into [data-panels] so the tablist only contains tabs. -->
    <div class="ways__comp" data-comp>
      <div class="ways__list" data-list>
        {items.map((it, i) => (
          <div class="ways__item" data-item>
            <h3 class="ways__h" data-heading>
              <button
                type="button"
                class:list={['ways__tab', { 'is-active': i === 0 }]}
                id={`ways-tab-${it.id}`}
                aria-controls={`ways-panel-${it.id}`}
                data-tab
              >
                <span class="ways__icon"><Icon name={it.icon} size={24} stroke={1.5} /></span>
                <span class="ways__label">{it.label}</span>
                <Icon name="chevron-down" size={20} class="ways__chevron" />
              </button>
            </h3>

            <div class="ways__panel" id={`ways-panel-${it.id}`} data-panel hidden={i !== 0}>
              <div class="ways__clip">
                <div class="ways__body">
                  <div class="ways__text">
                    <p class="ways__title anim" style="--d: 0ms">{it.title}</p>
                    <p class="ways__desc anim" style="--d: 50ms">{it.description}</p>
                    <ul class="ways__chips anim" style="--d: 100ms" role="list">
                      {it.chips.map((chip) => <li class="ways__chip">{chip}</li>)}
                    </ul>
                    <a class="btn btn--primary ways__cta anim" style="--d: 150ms" href="#bounties">
                      {it.cta}
                      <Icon name="arrow-right" size={18} class="btn__arrow" />
                    </a>
                  </div>

                  <!-- Decorative vignette -->
                  <div class="ways__visual" aria-hidden="true">
                    {it.visual === 'diff' && (
                      <div class="vig">
                        <div class="vig__head">
                          <code>src/sim/gripper.py</code>
                          <span><span class="vig__add">+3</span> <span class="vig__del">−2</span></span>
                        </div>
                        <div class="vig__diff">
                          {diff.map((l) => (
                            <div class={`vig__line vig__line--${l.type}`}>
                              <span class="vig__sign">{l.type === 'add' ? '+' : '−'}</span>
                              <code>{l.code}</code>
                            </div>
                          ))}
                        </div>
                      </div>
                    )}

                    {it.visual === 'pr' && (
                      <div class="vig">
                        <p class="vig__muted"><code>groundlink/telemetry</code> · Pull request #214</p>
                        <p class="vig__title">Decode CubeSat telemetry frames</p>
                        <div class="vig__pr-meta">
                          <span class="vig__muted">4 files changed</span>
                          <span class="vig__counts">
                            <span class="vig__add">+182</span>
                            <span class="vig__del">−24</span>
                            <span class="vig__bars">
                              <i class="is-add"></i><i class="is-add"></i><i class="is-add"></i><i class="is-add"></i><i class="is-del"></i>
                            </span>
                          </span>
                        </div>
                      </div>
                    )}

                    {it.visual === 'tests' && (
                      <div class="vig">
                        <div class="vig__head">
                          <code>tests/test_avoidance.py</code>
                          <span class="vig__muted">pytest</span>
                        </div>
                        <ul class="vig__tests" role="list">
                          {testRuns.map((t) => (
                            <li>
                              <span class="vig__check"><Icon name="check" size={12} stroke={2.4} /></span>
                              <code>{t}</code>
                            </li>
                          ))}
                        </ul>
                        <p class="vig__result"><strong>4 passed</strong> <span class="vig__muted">in 0.84s</span></p>
                      </div>
                    )}

                    {it.visual === 'doc' && (
                      <div class="vig">
                        <p class="vig__title">Build a custom agent tool</p>
                        <p class="vig__text">Register a tool once and the agent can call it whenever a task needs it.</p>
                        <p class="vig__text">Give it a clear name and a typed input.</p>
                        <pre class="vig__code"><code>@tool("search_issues")
def search(query: str) -&gt; list[Issue]:
    ...</code></pre>
                      </div>
                    )}

                    {it.visual === 'review' && (
                      <div class="vig">
                        <div class="vig__codeline">
                          <span class="vig__muted">88</span>
                          <code>await tool.call(args, {'{'} timeout: 30_000 {'}'})</code>
                        </div>
                        <div class="vig__comment">
                          <div class="vig__comment-head">
                            <span class="vig__avatar">L</span>
                            <strong>lena-w</strong>
                            <span class="vig__badge"><Icon name="check" size={12} stroke={2.4} /> Approved</span>
                          </div>
                          <p>Timeout plus backoff covers the hang. Nice, no other changes needed.</p>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Desktop panel column (filled by the script). -->
      <div class="ways__panels" data-panels></div>
    </div>

    <div class="ways__langs">
      <p class="ways__langs-label" id="ways-langs-label">Open bounties in</p>
      <ul class="ways__lang-list" aria-labelledby="ways-langs-label" role="list">
        {langs.map((l) => (
          <li><a class="ways__lang" href="#bounties">{l}</a></li>
        ))}
        <li><a class="ways__lang" href="#bounties" aria-label="32 more languages">+32 more</a></li>
      </ul>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-ways]');

  if (root) {
    const comp = root.querySelector<HTMLElement>('[data-comp]')!;
    const list = comp.querySelector<HTMLElement>('[data-list]')!;
    const host = comp.querySelector<HTMLElement>('[data-panels]')!;
    const items = [...list.querySelectorAll<HTMLElement>('[data-item]')];
    const headings = items.map((it) => it.querySelector<HTMLElement>('[data-heading]')!);
    const tabs = items.map((it) => it.querySelector<HTMLButtonElement>('[data-tab]')!);
    const panels = items.map((it) => it.querySelector<HTMLElement>('[data-panel]')!);

    const wide = window.matchMedia('(min-width: 1024px)');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const ACCORDION_MS = 250; // = --dur-base
    const FADE_OUT_MS = 160; // = --dur-fast

    let active = 0;
    let mode: 'tabs' | 'accordion' | null = null;
    let swapTimer: number | undefined;

    // Turn transitions off for one moment (first load, layout switch), so
    // nothing animates just because the page set its starting state.
    const instant = () => {
      comp.classList.add('is-instant');
      window.setTimeout(() => comp.classList.remove('is-instant'), 50);
    };

    // ---------- Desktop: tabs pattern ----------
    function toTabs() {
      mode = 'tabs';
      instant();
      comp.classList.add('is-tabs');
      comp.classList.remove('is-accordion');
      list.setAttribute('role', 'tablist');
      list.setAttribute('aria-orientation', 'vertical');
      list.setAttribute('aria-labelledby', 'ways-title');

      items.forEach((item, i) => {
        // The wrapper and <h3> become "presentation" so the tablist's children are just tabs.
        item.setAttribute('role', 'presentation');
        headings[i].setAttribute('role', 'presentation');

        const tab = tabs[i];
        tab.setAttribute('role', 'tab');
        tab.setAttribute('aria-selected', String(i === active));
        tab.tabIndex = i === active ? 0 : -1; // roving tabindex: only the active tab is in the tab order
        tab.removeAttribute('aria-expanded');
        tab.removeAttribute('aria-disabled');

        const panel = panels[i];
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', tab.id);
        panel.inert = false;
        panel.classList.remove('is-open', 'is-leaving', 'is-entering');
        panel.hidden = i !== active;
        host.append(panel); // panels move to the right-hand column
      });
    }

    // ---------- Tablet / mobile: accordion pattern ----------
    function toAccordion() {
      mode = 'accordion';
      instant();
      comp.classList.add('is-accordion');
      comp.classList.remove('is-tabs');
      list.removeAttribute('role');
      list.removeAttribute('aria-orientation');
      list.removeAttribute('aria-labelledby');

      items.forEach((item, i) => {
        item.removeAttribute('role');
        headings[i].removeAttribute('role');

        const tab = tabs[i];
        tab.removeAttribute('role');
        tab.removeAttribute('aria-selected');
        tab.removeAttribute('tabindex');
        tab.setAttribute('aria-expanded', String(i === active));
        // The open item can't be collapsed, so its header is marked disabled.
        if (i === active) tab.setAttribute('aria-disabled', 'true');
        else tab.removeAttribute('aria-disabled');

        const panel = panels[i];
        panel.setAttribute('role', 'region');
        panel.setAttribute('aria-labelledby', tab.id);
        panel.classList.remove('is-leaving', 'is-entering');
        panel.hidden = false; // closed panels stay rendered (0 height) so they can animate open
        panel.classList.toggle('is-open', i === active);
        panel.inert = i !== active; // closed panels: not focusable, not read out
        item.append(panel); // each panel goes back right under its header
      });
    }

    // ---------- Desktop panel swap: old fades out, new fades/rises in ----------
    function swapPanels(from: number, to: number) {
      window.clearTimeout(swapTimer);
      panels.forEach((p, n) => {
        if (n !== from && n !== to) {
          p.hidden = true;
          p.classList.remove('is-leaving', 'is-entering');
        }
      });
      const out = panels[from];
      const incoming = panels[to];

      if (reduceMotion.matches) {
        out.hidden = true;
        incoming.hidden = false;
        return;
      }

      out.classList.add('is-leaving'); // CSS: opacity 0 over 150ms
      swapTimer = window.setTimeout(() => {
        out.hidden = true;
        out.classList.remove('is-leaving');
        incoming.classList.add('is-entering'); // start state: transparent, 12px lower
        incoming.hidden = false;
        void incoming.offsetWidth; // apply the start state before removing it
        incoming.classList.remove('is-entering'); // transitions run, staggered by --d
      }, FADE_OUT_MS);
    }

    // ---------- Activate item i (the one rule: the active item never closes) ----------
    function activate(i: number, focus = false) {
      if (i === active) return; // clicking or pressing the open item does nothing
      const prev = active;
      active = i;
      tabs.forEach((t, n) => t.classList.toggle('is-active', n === i));

      if (mode === 'tabs') {
        tabs.forEach((t, n) => {
          t.setAttribute('aria-selected', String(n === i));
          t.tabIndex = n === i ? 0 : -1;
        });
        if (focus) tabs[i].focus();
        swapPanels(prev, i);
      } else {
        tabs.forEach((t, n) => {
          t.setAttribute('aria-expanded', String(n === i));
          if (n === i) t.setAttribute('aria-disabled', 'true');
          else t.removeAttribute('aria-disabled');
        });
        panels.forEach((p, n) => {
          p.classList.toggle('is-open', n === i);
          p.inert = n !== i;
        });
        // When the panel above closes, the new header can end up above the
        // screen. After the height animation, bring it back into view.
        window.setTimeout(() => {
          if (tabs[i].getBoundingClientRect().top < 0) {
            tabs[i].scrollIntoView({ behavior: reduceMotion.matches ? 'auto' : 'smooth', block: 'start' });
          }
        }, reduceMotion.matches ? 0 : ACCORDION_MS + 20);
      }
    }

    tabs.forEach((tab, i) => tab.addEventListener('click', () => activate(i)));

    // Tabs keyboard: Up/Down move and activate (wrapping), Home/End jump.
    list.addEventListener('keydown', (e) => {
      if (mode !== 'tabs') return;
      const last = tabs.length - 1;
      let next: number | null = null;
      if (e.key === 'ArrowDown') next = active === last ? 0 : active + 1;
      if (e.key === 'ArrowUp') next = active === 0 ? last : active - 1;
      if (e.key === 'Home') next = 0;
      if (e.key === 'End') next = last;
      if (next === null) return;
      e.preventDefault();
      if (next === active) tabs[active].focus();
      else activate(next, true);
    });

    const applyMode = () => (wide.matches ? toTabs() : toAccordion());
    applyMode();
    wide.addEventListener('change', applyMode);
  }
</script>

<style>
  .ways {
    --section-bg: var(--brand-tint);
    padding-block: var(--section-pad);
    color: var(--ink);
  }

  .ways__inner {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--content-pad);
  }

  /* ---------- Header ---------- */
  .ways__head {
    display: grid;
    gap: var(--space-5);
    padding-bottom: clamp(var(--space-6), 4vw, var(--space-8));
    border-bottom: 1px solid var(--line);
  }

  .ways__heading-main {
    font-size: var(--text-h1);
    font-weight: 600;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    color: var(--ink);
  }

  .ways__heading-main span { display: block; }

  .ways__intro {
    max-width: var(--measure-narrow);
    color: var(--ink-muted);
  }

  .ways__browse {
    margin-top: var(--space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-bottom: var(--space-1);
    border-bottom: 1.5px solid currentColor;
    font-size: var(--text-small);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
  }

  .ways__browse:hover { color: var(--brand); }

  @media (min-width: 1024px) {
    .ways__head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .ways__intro {
      justify-self: end;
      text-align: right;
    }
  }

  /* ---------- Items (accordion by default) ---------- */
  .ways__item { border-bottom: 1px solid var(--line); }

  .ways__h {
    margin: 0;
    font: inherit;
  }

  .ways__tab {
    position: relative;
    width: 100%;
    min-height: 56px;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    border: 0;
    background: none;
    text-align: left;
    font-family: var(--font-display);
    font-size: var(--text-h3);
    font-weight: 500;
    color: var(--ink-muted);
    transition: color var(--dur-fast) var(--ease-out);
  }

  .ways__tab.is-active {
    color: var(--ink);
    cursor: default; /* it can't be closed, so don't look clickable */
  }

  .ways__icon {
    flex: none;
    display: grid;
    color: var(--brand);
  }

  .ways__tab :global(.ways__chevron) {
    flex: none;
    margin-left: auto;
    color: var(--ink-muted);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .ways__tab.is-active :global(.ways__chevron) { transform: rotate(180deg); }

  /* The center-out line. scaleX(0) = no width; transform-origin: center makes
     it grow (and shrink) from the middle toward both ends. */
  .ways__tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px; /* sits on top of the item's 1px border */
    height: 2px;
    background: var(--brand);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform var(--dur-base) var(--ease-in), opacity var(--dur-base) var(--ease-in); /* shrinking back */
  }

  .ways__tab.is-active::after {
    transform: scaleX(1);
    opacity: 1;
    transition: transform var(--dur-slow) var(--ease-out); /* growing (ease-out) */
  }

  @media (hover: hover) {
    .ways__tab:not(.is-active):hover { color: var(--ink); }
    .ways__tab:not(.is-active):hover::after {
      transform: scaleX(0.3);
      opacity: 0.4;
    }
  }

  .ways__tab:focus-visible {
    outline-offset: -3px;
    border-radius: var(--radius-sm);
  }

  /* ---------- Panel content ---------- */
  .ways__panel[hidden] { display: none; }

  .ways__panel {
    display: grid;
    grid-template-rows: 1fr;
  }

  /* Clips the content while the row is shorter than it; the padding and
     negative margin keep focus rings from being cut off. */
  .ways__clip {
    min-height: 0;
    overflow: hidden;
    margin: 0 calc(-1 * var(--space-2));
    padding: 0 var(--space-2);
  }

  .ways__body {
    display: grid;
    gap: var(--space-5);
    padding: var(--space-1) 0 var(--space-6);
  }

  .ways__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  /* The header already shows the label on mobile, so the big title is desktop-only. */
  .ways__title { display: none; }

  .ways__desc {
    max-width: var(--measure-narrow);
    color: var(--ink-muted);
  }

  .ways__chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .ways__chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
    font-size: var(--text-small);
    color: var(--ink);
  }

  .ways__chip::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--brand);
  }

  .ways__cta {
    align-self: stretch;
  }

  /* ---------- Accordion (script adds .is-accordion below 1024px) ----------
     Height animation without measuring: the panel is a one-row grid whose row
     goes from 0fr (no height) to 1fr (exactly its content's height). */
  .is-accordion .ways__panel {
    grid-template-rows: 0fr;
    visibility: hidden;
    transition: grid-template-rows var(--dur-base) var(--ease-out), visibility 0s linear var(--dur-base);
  }

  .is-accordion .ways__panel.is-open {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows var(--dur-base) var(--ease-out), visibility 0s;
  }

  .ways__panels:empty { display: none; }

  /* No animation for the frame where the script sets the starting state. */
  .is-instant,
  .is-instant *,
  .is-instant *::after { transition: none !important; }

  /* ---------- Desktop tabs (script adds .is-tabs at >= 1024px) ---------- */
  @media (min-width: 1024px) {
    .ways__comp.is-tabs {
      display: grid;
      grid-template-columns: 28% minmax(0, 1fr);
    }

    .is-tabs .ways__list { border-right: 1px solid var(--line); }
    .is-tabs .ways__item:last-child { border-bottom: 0; }

    .is-tabs .ways__tab {
      padding: var(--space-6) var(--space-5) var(--space-6) 0;
      font-size: var(--text-h3);
    }

    .is-tabs .ways__tab :global(.ways__chevron) { display: none; }

    .is-tabs .ways__panels {
      display: grid;
      align-items: center;
      padding: var(--space-7) 0 var(--space-7) clamp(var(--space-6), 4vw, var(--space-9));
    }

    .is-tabs .ways__panel { grid-area: 1 / 1; } /* all panels share one cell */

    .is-tabs .ways__body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
      align-items: center;
      gap: clamp(var(--space-6), 4vw, var(--space-9));
      padding: var(--space-1) 0;
    }

    .is-tabs .ways__text { gap: var(--space-5); }

    .is-tabs .ways__title {
      display: block;
      font-family: var(--font-display);
      font-size: var(--text-h2);
      font-weight: 400;
      line-height: var(--leading-tight);
      letter-spacing: var(--tracking-tight);
      color: var(--ink);
    }

    .is-tabs .ways__cta { align-self: flex-start; }

    /* Panel swap. Outgoing: quick fade. Incoming: each piece rises 12px and
       fades in, staggered by --d; the visual scales up from 0.96. */
