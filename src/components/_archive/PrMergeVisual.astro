---
// ARCHIVED: the original hero visual (code diff -> PR card with AI checks ->
// "Merged" badge -> PayPal payout toast), with its one-time load sequence.
// Not rendered anywhere. Kept to reuse in the HowItWorks section later.
// To use it: import PrMergeVisual from './_archive/PrMergeVisual.astro' and
// render <PrMergeVisual /> inside a positioned container.
// Note: the .stat / .avatar rules below are scoped to this component.

// A plausible fix for a queue worker race condition:
// "peek, then lock" lets two workers grab the same job; an atomic claim does not.
const diffLines = [
  { type: 'ctx', num: 41, code: 'async function nextJob(queue, workerId) {' },
  { type: 'del', num: 42, code: '  const job = await queue.peek();' },
  { type: 'del', num: 43, code: '  await queue.lock(job.id, workerId);' },
  { type: 'add', num: 42, code: '  const job = await queue.claimNext(workerId, {' },
  { type: 'add', num: 43, code: '    lockTtlMs: 30_000,' },
  { type: 'add', num: 44, code: '  });' },
  { type: 'ctx', num: 45, code: '  if (!job) return null;' },
  { type: 'ctx', num: 46, code: '  return runJob(job);' },
];

const checks = ['Meets bounty requirements', 'Tests pass', 'No security issues'];

// PLACEHOLDER DEMO STATS: replace with real numbers before launch.
const stats = [
  { value: '40+', label: 'languages & frameworks' },
  { value: '~5 min', label: 'from merge to payout' },
  { value: '$250', label: 'average bounty' },
];

const payoutAmount = 350;
---

<div class="pr-visual">
  <p class="visually-hidden">Example: pull request merged, $350 paid via PayPal.</p>

  <div class="hv" aria-hidden="true" data-hero-visual>
    <div class="hv__shape hv__shape--violet"></div>
    <div class="hv__shape hv__shape--green"></div>

    <!-- Back layer: the code diff -->
    <div class="diff">
      <div class="diff__head">
        <span>src/queue/worker.ts</span>
        <span class="diff__counts"><span class="diff__plus">+3</span> <span class="diff__minus">−2</span></span>
      </div>
      {diffLines.map((line) => (
        <div class={`diff__line diff__line--${line.type}`}>
          <span class="diff__num">{line.num}</span>
          <span class="diff__sign">{line.type === 'del' ? '-' : line.type === 'add' ? '+' : ' '}</span>
          <span class="diff__code">{line.code}</span>
        </div>
      ))}
    </div>

    <!-- Front layer: the PR card + payout toast -->
    <div class="hv__pr-wrap">
      <div class="pr">
        <div class="pr__top">
          <span class="badge" data-badge>
            <span class="badge__label badge__label--review">
              <svg viewBox="0 0 16 16" width="14" height="14"><circle cx="8" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle></svg>
              In review
            </span>
            <span class="badge__label badge__label--merged">
              <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round">
                <circle cx="4.5" cy="3.5" r="1.75"></circle>
                <circle cx="4.5" cy="12.5" r="1.75"></circle>
                <circle cx="11.5" cy="8" r="1.75"></circle>
                <path d="M4.5 5.25v5.5M4.5 5.25c0 2.4 2 2.75 5.25 2.75"></path>
              </svg>
              Merged
            </span>
          </span>
          <span class="pr__num">PR #482</span>
        </div>

        <p class="pr__title">Fix race condition in queue worker</p>

        <div class="pr__author">
          <span class="avatar">A</span>
          <span class="pr__handle">amara-o</span>
          <span>into main</span>
        </div>

        <div class="pr__review">
          <p class="pr__review-title">
            <svg viewBox="0 0 16 16" width="14" height="14" fill="currentColor">
              <path d="M8 1.5l1.6 4.1 4.1 1.6-4.1 1.6L8 12.9 6.4 8.8 2.3 7.2l4.1-1.6z"></path>
            </svg>
            AI review
          </p>
          <ul class="checks">
            {checks.map((label) => (
              <li class="check" data-check>
                <span class="check__box">
                  <svg viewBox="0 0 16 16" width="12" height="12">
                    <path d="M3.5 8.5l3 3 6-7" pathLength="1"></path>
                  </svg>
                </span>
                {label}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="toast" data-toast>
        <span class="toast__icon">
          <svg viewBox="0 0 16 16" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 12.5v-9M4 7.5l4-4 4 4"></path>
          </svg>
        </span>
        <span><span class="toast__amount" data-amount={payoutAmount}>+${payoutAmount.toFixed(2)}</span> sent via PayPal</span>
        <span class="toast__time">· just now</span>
      </div>
    </div>

    <!-- PLACEHOLDER DEMO STATS: not real figures yet. -->
    <ul class="hv__stats">
      {stats.map((stat, i) => (
        <li class={`stat stat--${i + 1}`}>
          <span class="stat__value">{stat.value}</span>
          <span class="stat__label">{stat.label}</span>
        </li>
      ))}
    </ul>
  </div>

  <!--
    Load sequence. Inline so it runs before first paint: it switches the visual
    into its "before" state, then steps it to the final state. Without JS, or
    with reduced motion, the final state in the HTML is shown as-is.
  -->
  <script is:inline>
    (() => {
      const root = document.querySelector('[data-hero-visual]');
      if (!root || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const checks = root.querySelectorAll('[data-check]');
      const badge = root.querySelector('[data-badge]');
      const toast = root.querySelector('[data-toast]');
      const amount = root.querySelector('[data-amount]');
      const target = Number(amount.dataset.amount);
      const format = (n) =>
        '+$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      // 1. Rewind to the "before" state.
      root.classList.add('is-sequencing');
      amount.textContent = format(0);

      // 2. Schedule each step (ms after load).
      const CHECKS_START = 900;
      const CHECK_GAP = 400;
      const MERGE_AT = CHECKS_START + checks.length * CHECK_GAP + 200; // 2300
      const PAYOUT_AT = MERGE_AT + 500; // 2800
      const COUNT_DURATION = 800; // ends ~3600

      checks.forEach((el, i) => {
        setTimeout(() => el.classList.add('is-done'), CHECKS_START + i * CHECK_GAP);
      });
      setTimeout(() => badge.classList.add('is-done'), MERGE_AT);
      setTimeout(() => {
        toast.classList.add('is-done');
        countUp();
      }, PAYOUT_AT);

      // 3. Count $0.00 -> $350.00 with an ease-out curve, one frame at a time.
      function countUp() {
        let start;
        const frame = (now) => {
          if (start === undefined) start = now;
          const t = Math.min((now - start) / COUNT_DURATION, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          amount.textContent = format(target * eased);
          if (t < 1) requestAnimationFrame(frame);
        };
        requestAnimationFrame(frame);
      }
    })();
  </script>
</div>

<style>
  /* ---------- Visual: composition (mobile first) ---------- */
  .hv {
    position: relative;
    padding-top: clamp(116px, 24vw, 150px);
    font-size: 1rem;
  }

  .hv__shape {
    position: absolute;
    z-index: 0;
    aspect-ratio: 1;
  }

  .hv__shape--violet {
    width: 80%;
    top: -8%;
    right: -12%;
    background: var(--merged-tint);
    border-radius: 42% 58% 62% 38% / 45% 40% 60% 55%;
  }

  .hv__shape--green {
    width: 58%;
    bottom: -6%;
    left: -10%;
    background: var(--payout-tint);
    border-radius: 58% 42% 38% 62% / 52% 60% 40% 48%;
  }

  /* Back layer: diff panel */
  .diff {
    position: absolute;
    z-index: 1;
    top: 0;
    left: 0;
    width: 88%;
    transform: rotate(-3deg);
    transform-origin: top left;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
    font-family: var(--font-code);
    font-size: clamp(0.6875rem, 0.6rem + 0.3vw, 0.8125rem);
    line-height: 1.8;
    box-shadow: 0 12px 32px -16px color-mix(in srgb, var(--ink) 25%, transparent);
  }

  .diff__head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 12px;
    background: var(--canvas);
    border-bottom: 1px solid var(--line);
    color: var(--ink-muted);
  }

  .diff__plus { color: var(--payout); }
  .diff__minus { color: var(--removed); }

  .diff__line {
    display: grid;
    grid-template-columns: 2.6em 1.4em minmax(0, 1fr);
    white-space: pre;
    color: var(--ink);
  }

  .diff__num {
    padding-right: 0.6em;
    text-align: right;
    color: var(--ink-muted);
  }

  .diff__code { overflow: hidden; }
  .diff__line--del { background: var(--removed-tint); }
  .diff__line--del .diff__sign { color: var(--removed); }
  .diff__line--add { background: var(--payout-tint); }
  .diff__line--add .diff__sign { color: var(--payout); }

  /* Front layer: PR card */
  .hv__pr-wrap {
    position: relative;
    z-index: 2;
    width: 94%;
    margin-left: auto;
    margin-bottom: 36px;
  }

  .pr {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: clamp(16px, 2.2vw, 24px);
    box-shadow:
      0 28px 56px -28px color-mix(in srgb, var(--ink) 35%, transparent),
      0 2px 6px color-mix(in srgb, var(--ink) 6%, transparent);
  }

  .pr__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .pr__num {
    font-family: var(--font-code);
    font-size: 0.8125rem;
    color: var(--ink-muted);
  }

  .pr__title {
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.0625rem, 0.95rem + 0.5vw, 1.375rem);
    line-height: 1.25;
    color: var(--ink);
  }

  .pr__author {
    margin-top: 10px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  .pr__handle {
    font-family: var(--font-code);
    font-weight: 500;
    color: var(--ink);
  }

  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--merged-tint);
    color: var(--merged);
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .pr__review {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  .pr__review-title {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .pr__review-title svg { color: var(--merged); }

  .checks {
    list-style: none;
    padding: 0;
    margin-top: 12px;
    display: grid;
    gap: 10px;
  }

  .check {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9375rem;
    color: var(--ink);
    transition: color 200ms ease;
  }

  .check__box {
    flex: none;
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--payout-tint);
    color: var(--payout);
    transition: background-color 200ms ease, box-shadow 200ms ease;
  }

  .check__box path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    /* pathLength="1" makes the whole stroke exactly 1 unit long. */
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 350ms ease-out, opacity 0s;
  }

  /* Badge: final ("Merged") state is the default */
  .badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 600;
    background: var(--merged);
    color: var(--surface);
    transition: background-color 200ms ease, color 200ms ease, box-shadow 200ms ease;
  }

  .badge__label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .badge__label--review { display: none; }

  /* Payout toast */
  .toast {
    position: absolute;
    right: clamp(12px, 3vw, 24px);
    bottom: -24px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--ink);
    white-space: nowrap;
    box-shadow: 0 16px 32px -16px color-mix(in srgb, var(--ink) 35%, transparent);
    transition:
      opacity 350ms ease,
      transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .toast__icon {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--payout);
    color: var(--surface);
  }

  .toast__amount {
    display: inline-block;
    min-width: 7.5ch;
    font-family: var(--font-code);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--payout);
  }

  .toast__time { color: var(--ink-muted); }

  /* Floating stat cards: a row of chips on mobile */
  .hv__stats {
    position: relative;
    z-index: 3;
    list-style: none;
    padding: 0;
    margin-top: 12px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    padding: 10px 12px;
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    box-shadow: 0 12px 24px -16px color-mix(in srgb, var(--ink) 30%, transparent);
  }

  .stat__value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.15;
    color: var(--ink);
  }

  .stat__label {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--ink-muted);
  }

  /* ---------- Visual: desktop composition ---------- */
  @media (min-width: 900px) {
    .hv {
      padding-top: clamp(150px, 14vw, 190px);
      padding-bottom: 76px;
    }

    .diff {
      top: 28px;
      width: 78%;
    }

    .hv__pr-wrap { width: 72%; }

    .hv__stats {
      position: static;
      display: block;
      margin: 0;
    }

    .stat {
      position: absolute;
      z-index: 3;
      max-width: 9.5rem;
      padding: 12px 16px;
    }

    .stat__value { font-size: 1.5rem; }
    .stat__label { font-size: 0.8125rem; }

    .stat--1 { top: 0; right: 0; }
    .stat--2 { left: 0; top: 54%; }
    .stat--3 { left: 8%; bottom: 0; }
  }

  /* ---------- Load sequence "before" state ----------
     The inline script adds .is-sequencing, then adds .is-done to each piece. */
  .is-sequencing .check:not(.is-done) { color: var(--ink-muted); }

  .is-sequencing .check:not(.is-done) .check__box {
    background: var(--canvas);
    box-shadow: inset 0 0 0 1.5px var(--line);
  }

  .is-sequencing .check:not(.is-done) .check__box path {
    stroke-dashoffset: 1;
    opacity: 0;
  }

  .is-sequencing .badge:not(.is-done) {
    background: var(--canvas);
    color: var(--ink-muted);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .is-sequencing .badge:not(.is-done) .badge__label--review { display: inline-flex; }
  .is-sequencing .badge:not(.is-done) .badge__label--merged { display: none; }
  .is-sequencing .badge.is-done { animation: badge-pulse 420ms ease-out; }

  .is-sequencing .toast:not(.is-done) {
    opacity: 0;
    transform: translateY(20px);
  }

  @keyframes badge-pulse {
    0% { transform: scale(1); }
    40% { transform: scale(1.14); }
    100% { transform: scale(1); }
  }

</style>
