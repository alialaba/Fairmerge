---
// Fairmerge logo: a merge mark (two lines joining into one) + the wordmark.
// theme="dark" makes the wordmark white for dark backgrounds (e.g. a footer).
interface Props {
  theme?: 'light' | 'dark';
  class?: string;
}

const { theme = 'light', class: className } = Astro.props;
---

<a class:list={['logo', `logo--${theme}`, className]} href="/" aria-label="Fairmerge home">
  <svg class="logo__mark" viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <!-- Two branches come down from the top and merge into one line. -->
    <path d="M6 3v4c0 4.5 6 5.5 6 10v4"></path>
    <path d="M18 3v4c0 4.5-6 5.5-6 10"></path>
  </svg>
  <span class="logo__word" aria-hidden="true">fairmerge</span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px; /* comfortable tap target */
    text-decoration: none;
    border-radius: var(--radius-sm);
  }

  .logo__mark {
    flex: none;
    color: var(--merged);
  }

  .logo__word {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .logo--dark .logo__word { color: var(--surface); }
  .logo--dark .logo__mark { color: var(--merged-tint); } /* violet would be too dark on --ink */
</style>
