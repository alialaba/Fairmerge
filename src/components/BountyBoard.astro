---
// BountyBoard: filterable bounty cards with an inline counter-offer form.
// Cards are rendered from the `bounties` array below. To add a bounty, add one
// object; the filters and counter-offer panel pick it up automatically.
import Icon from './ui/Icon.astro';

// SAMPLE DEMO CONTENT: fictional repositories and bounties, not real listings.
// Two each from robotics, space, and AI agent projects.
const bounties = [
  {
    id: 'arm-jitter',
    repo: 'openarm/motion-planner',
    title: 'Fix arm jitter near joint limits',
    description: 'The 6-axis arm oscillates when a target sits close to a joint limit. Smooth the IK solver output and add a simulation test.',
    domain: 'Robotics',
    language: 'C++',
    type: 'Bug fix',
    difficulty: 'Advanced',
    estimate: '~12 hrs',
    price: 900,
    fairRangeMin: 800,
    fairRangeMax: 1050,
  },
  {
    id: 'nav-tests',
    repo: 'trailbot/nav-stack',
    title: 'Add tests for obstacle-avoidance edge cases',
    description: 'Cover glass walls, people walking past, and dropped lidar frames in the simulated test suite.',
    domain: 'Robotics',
    language: 'Python',
    type: 'Tests',
    difficulty: 'Beginner',
    estimate: '~3 hrs',
    price: 150,
    fairRangeMin: 120,
    fairRangeMax: 180,
  },
  {
    id: 'orbit-speed',
    repo: 'orbitkit/propagator',
    title: 'Speed up satellite orbit propagation',
    description: 'Batch the SGP4 step so 10,000 satellites update in under a second. Include before-and-after benchmarks.',
    domain: 'Space',
    language: 'Rust',
    type: 'Performance',
    difficulty: 'Advanced',
    estimate: '~10 hrs',
    price: 850,
    fairRangeMin: 750,
    fairRangeMax: 1000,
  },
  {
    id: 'cubesat-telemetry',
    repo: 'groundlink/telemetry',
    title: 'Decode CubeSat telemetry frames',
    description: 'Parse AX.25 beacon frames from a 3U CubeSat into typed fields, using the sample captures as fixtures.',
    domain: 'Space',
    language: 'Go',
    type: 'Feature',
    difficulty: 'Intermediate',
    estimate: '~6 hrs',
    price: 400,
    fairRangeMin: 350,
    fairRangeMax: 450,
  },
  {
    id: 'agent-timeouts',
    repo: 'relaykit/agents',
    title: 'Add timeouts and retries to agent tool calls',
    description: 'Agents hang when a tool never responds. Add per-tool timeouts, backoff, and an error message the agent can act on.',
    domain: 'AI agents',
    language: 'TypeScript',
    type: 'Feature',
    difficulty: 'Intermediate',
    estimate: '~5 hrs',
    price: 320,
    fairRangeMin: 280,
    fairRangeMax: 360,
  },
  {
    id: 'agent-tool-guide',
    repo: 'taskpilot/core',
    title: 'Write a guide to building a custom agent tool',
    description: 'Walk through one tool end to end: its schema, the handler, tests, and how the agent decides when to call it.',
    domain: 'AI agents',
    language: 'Python',
    type: 'Docs',
    difficulty: 'Beginner',
    estimate: '~3 hrs',
    price: 180,
    fairRangeMin: 150,
    fairRangeMax: 210,
  },
];

// Language chips come from the data, so every chip matches at least one bounty.
const languages = ['All', ...new Set(bounties.map((b) => b.language))];
const difficulties = ['All', 'Beginner', 'Intermediate', 'Advanced'];
const filters = [
  { key: 'language', label: 'Language', options: languages },
  { key: 'difficulty', label: 'Difficulty', options: difficulties },
];

const usd = (n: number) => `$${n.toLocaleString('en-US')}`;
---

<section class="board section" id="bounties" aria-labelledby="board-title" data-board>
  <div class="board__inner">
    <header class="board__head">
      <div class="board__intro">
        <h2 class="board__title" id="board-title">
          <span>Open bounties,</span>
          <span>live now.</span>
        </h2>
        <p class="board__lede">Real issues from robotics, space, and AI agent projects. Paid on merge, via PayPal.</p>
      </div>
      <a class="btn btn--secondary btn--lg" href="#">
        See all 24 bounties
        <Icon name="arrow-right" size={18} class="btn__arrow" />
      </a>
    </header>

    <div class="board__filters">
      {filters.map((f) => (
        <div class="filter" role="group" aria-labelledby={`filter-${f.key}`}>
          <span class="filter__label" id={`filter-${f.key}`}>{f.label}</span>
          <div class="filter__chips">
            {f.options.map((opt) => (
              <button
                type="button"
                class="chip"
                aria-pressed={opt === 'All' ? 'true' : 'false'}
                data-filter={f.key}
                data-value={opt === 'All' ? 'all' : opt}
              >
                {opt}
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>

    <p class="visually-hidden" aria-live="polite" data-count></p>
  </div>

  <!-- Mobile/tablet: horizontal scroll-snap carousel. Desktop: 3-column grid.
       role/tabindex are removed by the script on desktop, where it is a plain grid. -->
  <div class="board__track" role="region" aria-label="Open bounties" tabindex="0" data-track>
    <ul class="board__grid" role="list">
      {bounties.map((b) => (
        <li class="board__item" data-card data-language={b.language} data-difficulty={b.difficulty}>
          <article class="bcard" aria-labelledby={`${b.id}-title`}>
            <ul class="bcard__tags" role="list">
              <li class="tag tag--domain">{b.domain}</li>
              <li class="tag">{b.language}</li>
              <li class="tag">{b.type}</li>
            </ul>
            <p class="bcard__repo">{b.repo}</p>
            <h3 class="bcard__title" id={`${b.id}-title`}>{b.title}</h3>
            <p class="bcard__desc">{b.description}</p>
            <ul class="bcard__meta" role="list">
              <li>
                <Icon name="level" size={16} />
                <span class="visually-hidden">Difficulty: </span>{b.difficulty}
              </li>
              <li>
                <Icon name="clock" size={16} />
                <span class="visually-hidden">Estimate: </span>{b.estimate}
              </li>
            </ul>

            <div class="bcard__foot">
              <p class="bcard__price">
                <span class="bcard__amount">{usd(b.price)}</span>
                <span class="bcard__paid">paid on merge</span>
              </p>
              <a class="btn btn--primary btn--sm" href="#">
                Claim bounty<span class="visually-hidden">: {b.title}</span>
                <Icon name="arrow-right" size={16} class="btn__arrow" />
              </a>
            </div>

            <button
              type="button"
              class="bcard__counter"
              aria-expanded="false"
              aria-controls={`${b.id}-offer`}
              data-offer-toggle
            >
              Counter-offer<span class="visually-hidden">: {b.title}</span>
            </button>

            <!-- Collapsible panel: grid-template-rows 0fr -> 1fr animates the height. -->
            <div class="offer" id={`${b.id}-offer`} data-offer data-max={b.fairRangeMax}>
              <div class="offer__clip">
                <form class="offer__form" novalidate data-offer-form>
                  <label class="offer__label" for={`${b.id}-amount`}>Your counter-offer</label>
                  <div class="offer__field">
                    <span class="offer__prefix" aria-hidden="true">$</span>
                    <input
                      class="offer__input"
                      id={`${b.id}-amount`}
                      name="amount"
                      type="text"
                      inputmode="decimal"
                      autocomplete="off"
                      value={b.price}
                      aria-describedby={`${b.id}-hint`}
                      data-offer-input
                    />
                  </div>
                  <p class="offer__hint" id={`${b.id}-hint`}>
                    AI fair range: {usd(b.fairRangeMin)}–{usd(b.fairRangeMax)} based on this issue's complexity
                  </p>
                  <p class="offer__error" id={`${b.id}-error`} hidden data-offer-error>
                    Enter an amount in dollars.
                  </p>
                  <p class="offer__note" id={`${b.id}-note`} hidden data-offer-note>
                    Above the AI fair range. Maintainers accept these less often.
                  </p>
                  <div class="offer__actions">
                    <button type="submit" class="btn btn--primary btn--sm">Send offer</button>
                    <button type="button" class="offer__cancel" data-offer-cancel>Cancel</button>
                  </div>
                </form>
              </div>
            </div>

            <p class="offer__sent" role="status" tabindex="-1" hidden data-offer-sent></p>
          </article>
        </li>
      ))}
    </ul>
  </div>

  <div class="board__inner">
    <div class="board__empty" hidden data-empty>
      <p>No bounties match these filters yet.</p>
      <button type="button" class="btn btn--secondary btn--sm" data-clear>Clear filters</button>
    </div>

    <div class="board__cta">
      <a class="btn btn--primary btn--lg" href="#">
        See all open bounties
        <Icon name="arrow-right" size={18} class="btn__arrow" />
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-board]').forEach((section) => {
    const track = section.querySelector<HTMLElement>('[data-track]')!;
    const cards = [...section.querySelectorAll<HTMLElement>('[data-card]')];
    const chips = [...section.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const count = section.querySelector<HTMLElement>('[data-count]')!;
    const empty = section.querySelector<HTMLElement>('[data-empty]')!;
    const clear = section.querySelector<HTMLButtonElement>('[data-clear]')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wide = window.matchMedia('(min-width: 1024px)');
    const FADE_MS = 200; // a little longer than --dur-fast (160ms), so the fade always finishes

    /* ---------------- Carousel vs grid ----------------
       Below 1024px the track is a scrollable carousel, so it is a labelled,
       focusable region. On desktop it is a plain grid: no extra tab stop. */
    const applyLayout = () => {
      if (wide.matches) {
        track.removeAttribute('role');
        track.removeAttribute('aria-label');
        track.removeAttribute('tabindex');
      } else {
        track.setAttribute('role', 'region');
        track.setAttribute('aria-label', 'Open bounties');
        track.setAttribute('tabindex', '0');
      }
    };
    applyLayout();
    wide.addEventListener('change', applyLayout);

    /* ---------------- Filters ----------------
       The current choice of each filter lives here. A card is shown only if it
       passes BOTH checks: language matches (or "all") AND difficulty matches. */
    const state: Record<string, string> = { language: 'all', difficulty: 'all' };
    let run = 0; // increases on every filter change; stale timers check it and stop

    const matches = (card: HTMLElement) =>
      (state.language === 'all' || card.dataset.language === state.language) &&
      (state.difficulty === 'all' || card.dataset.difficulty === state.difficulty);

    const applyFilters = () => {
      const id = ++run;
      const show = cards.map(matches);
      const n = show.filter(Boolean).length;
      count.textContent =
        n === 0 ? 'No bounties match these filters.' : `Showing ${n} ${n === 1 ? 'bounty' : 'bounties'}`;

      // Close any counter-offer panel in a card that is about to disappear.
      cards.forEach((card, i) => { if (!show[i]) closeOffer(card, false); });

      const finish = () => {
        cards.forEach((card, i) => {
          if (show[i] && card.hidden) {
            // Start invisible, unhide, then drop the class so it transitions in.
            card.classList.add('is-out');
            card.hidden = false;
          } else if (!show[i]) {
            card.hidden = true;
          }
        });
        empty.hidden = n !== 0;
        track.scrollLeft = 0; // carousel: start from the first match
        void track.offsetWidth; // force a layout so the 'is-out' start state is applied
        cards.forEach((card, i) => { if (show[i]) card.classList.remove('is-out'); });
      };

      if (reduceMotion.matches) {
        cards.forEach((card) => card.classList.remove('is-out'));
        finish();
        return;
      }

      // Phase 1: fade + shrink the cards that no longer match (still in the layout).
      let leaving = 0;
      cards.forEach((card, i) => {
        if (!show[i] && !card.hidden) { card.classList.add('is-out'); leaving++; }
        if (show[i] && !card.hidden) card.classList.remove('is-out'); // re-matched mid-fade
      });
      // Phase 2: remove them from the layout and fade the newly matching ones in.
      window.setTimeout(() => { if (id === run) finish(); }, leaving ? FADE_MS : 0);
    };

    const setFilter = (key: string, value: string) => {
      state[key] = value;
      // Exactly one pressed chip per filter row: the one matching the state.
      chips.forEach((chip) =>
        chip.setAttribute('aria-pressed', String(state[chip.dataset.filter!] === chip.dataset.value)),
      );
      applyFilters();
    };

    chips.forEach((chip) =>
      chip.addEventListener('click', () => setFilter(chip.dataset.filter!, chip.dataset.value!)),
    );

    clear.addEventListener('click', () => {
      state.language = 'all';
      setFilter('difficulty', 'all'); // updates the chips and re-filters with both reset
      // The clear button is about to disappear, so move focus somewhere sensible.
      chips.find((c) => c.dataset.filter === 'language')?.focus();
    });

    /* ---------------- Counter-offer ----------------
       Each card has a toggle button, a panel, and a hidden confirmation line.
       Opening = add .is-open (CSS animates the height) + aria-expanded="true".
       The panel uses visibility:hidden when closed, so its fields can't be
       tabbed to or read out while collapsed. */
    const parts = (card: HTMLElement) => ({
      toggle: card.querySelector<HTMLButtonElement>('[data-offer-toggle]')!,
      panel: card.querySelector<HTMLElement>('[data-offer]')!,
      input: card.querySelector<HTMLInputElement>('[data-offer-input]')!,
      error: card.querySelector<HTMLElement>('[data-offer-error]')!,
      note: card.querySelector<HTMLElement>('[data-offer-note]')!,
      sent: card.querySelector<HTMLElement>('[data-offer-sent]')!,
    });

    // aria-describedby always includes the hint; the error or the note is added when shown.
    const describe = (p: ReturnType<typeof parts>) => {
      const ids = [p.input.id.replace('-amount', '-hint')];
      if (!p.error.hidden) ids.push(p.error.id);
      if (!p.note.hidden) ids.push(p.note.id);
      p.input.setAttribute('aria-describedby', ids.join(' '));
    };

    // Returns the amount as a number, or null if it isn't a positive dollar value.
    const parseAmount = (raw: string) => {
      const clean = raw.trim().replace(/[$,\s]/g, '');
      if (!/^\d+(\.\d{1,2})?$/.test(clean)) return null;
      const value = Number(clean);
      return value > 0 ? value : null;
    };

    const updateNote = (card: HTMLElement) => {
      const p = parts(card);
      const value = parseAmount(p.input.value);
      p.note.hidden = !(value !== null && value > Number(p.panel.dataset.max));
      describe(p);
    };

    function closeOffer(card: HTMLElement, returnFocus: boolean) {
      const p = parts(card);
      if (!p.panel.classList.contains('is-open')) return;
      p.panel.classList.remove('is-open');
      p.toggle.setAttribute('aria-expanded', 'false');
      if (returnFocus) p.toggle.focus();
    }

    const openOffer = (card: HTMLElement) => {
      cards.forEach((other) => { if (other !== card) closeOffer(other, false); }); // one at a time
      const p = parts(card);
      p.panel.classList.add('is-open');
      p.toggle.setAttribute('aria-expanded', 'true');
      updateNote(card);
      p.input.focus({ preventScroll: true });
      p.input.select();
    };

    cards.forEach((card) => {
      const p = parts(card);

      p.toggle.addEventListener('click', () =>
        p.panel.classList.contains('is-open') ? closeOffer(card, true) : openOffer(card),
      );

      card.querySelector('[data-offer-cancel]')!.addEventListener('click', () => closeOffer(card, true));

      p.panel.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') { e.preventDefault(); closeOffer(card, true); }
      });

      p.input.addEventListener('input', () => {
        // Clear the error as soon as the value becomes valid again.
        if (!p.error.hidden && parseAmount(p.input.value) !== null) {
          p.error.hidden = true;
          p.input.removeAttribute('aria-invalid');
        }
        updateNote(card);
      });

      card.querySelector('[data-offer-form]')!.addEventListener('submit', (e) => {
        e.preventDefault();
        const value = parseAmount(p.input.value);
        if (value === null) {
          p.error.hidden = false;
          p.input.setAttribute('aria-invalid', 'true');
          describe(p);
          p.input.focus();
          return;
        }
        // Demo only: nothing is sent anywhere. The confirmation replaces the
        // panel and the toggle for the rest of this visit (in memory only).
        const amount = value % 1 ? value.toFixed(2) : value.toLocaleString('en-US');
        p.sent.textContent = `Offer sent: $${amount}. You'll hear back when the maintainer responds.`;
        p.panel.classList.remove('is-open');
        p.panel.hidden = true;
        p.toggle.setAttribute('aria-expanded', 'false');
        p.toggle.hidden = true;
        p.sent.hidden = false;
        p.sent.focus();
      });
    });
  });
</script>

<style>
  .board {
    --section-bg: var(--canvas);
    --edge: max(var(--content-pad), calc((100% - var(--content-width)) / 2 + var(--content-pad)));
    --gap: clamp(14px, 1.6vw, 24px);
    padding-block: var(--section-pad);
    color: var(--ink);
  }

  .board__inner {
    max-width: var(--content-width);
    margin-inline: auto;
    padding-inline: var(--content-pad);
  }

  /* ---------- Header ---------- */
  .board__head {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .board__title {
    font-weight: 600;
    color: var(--ink);
  }

  .board__title span { display: block; }

  .board__lede {
    margin-top: var(--space-4);
    max-width: var(--measure-narrow);
    font-size: var(--text-body-lg);
    color: var(--ink-muted);
  }

  /* ---------- Filters ---------- */
  .board__filters {
    margin-top: var(--gap-section-head);
    display: grid;
    gap: var(--space-4);
  }

  .filter {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
  }

  .filter__label {
    font-size: var(--text-caption);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* Mobile: one row that scrolls sideways. The negative margin lets the row run
     to the screen edge; the padding keeps the first chip aligned and leaves
     room for focus rings. */
  .filter__chips {
    display: flex;
    gap: var(--space-2);
    margin-inline: calc(var(--content-pad) * -1);
    padding: var(--space-2) var(--content-pad);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .filter__chips::-webkit-scrollbar { display: none; }

  .chip {
    flex: none;
    min-height: 40px;
    padding: 0 var(--space-4);
    border: 1px solid var(--ink-muted);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--text-small);
    font-weight: 500;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
  }

  .chip:hover { border-color: var(--brand); color: var(--brand); }

  .chip[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--surface);
  }

  @media (min-width: 768px) {
    .filter__chips {
      flex-wrap: wrap;
      margin-inline: 0;
      padding-inline: 0;
      overflow: visible;
    }
  }

  @media (min-width: 1024px) {
    .board__head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
    }

    .board__filters {
      grid-template-columns: auto auto;
      justify-content: start;
      column-gap: var(--space-8);
    }
  }

  /* ---------- Cards: carousel (< 1024px) ---------- */
  .board__track {
    container-type: inline-size;
    margin-top: clamp(var(--space-5), 3vw, var(--space-7));
    padding: var(--space-2) var(--edge) var(--space-4);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    scrollbar-width: none;
  }

  .board__track::-webkit-scrollbar { display: none; }

  .board__track:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: -3px;
    border-radius: var(--radius-sm);
  }

  .board__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--gap);
    width: max-content;
  }

  .board__item {
    flex: 0 0 85cqi; /* ~85% of the visible row: the next card peeks in */
    display: flex;
    scroll-snap-align: start;
    transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }

  .board__item[hidden] { display: none; }

  /* Filter transition state: faded and slightly smaller. */
  .board__item.is-out {
    opacity: 0;
    transform: scale(0.96);
  }

  @media (min-width: 640px) {
    .board__item { flex-basis: 45cqi; }
  }

  /* ---------- Cards: grid (>= 1024px) ---------- */
  @media (min-width: 1024px) {
    .board__track {
      max-width: var(--content-width);
      margin-inline: auto;
      padding: var(--space-2) var(--content-pad) 0;
      overflow: visible;
      scroll-snap-type: none;
    }

    .board__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: auto;
    }

  }

  /* ---------- Card ---------- */
  .bcard {
    /* Positioned so absolutely positioned children (the visually hidden
       "Claim bounty: …" text) stay inside the carousel's scroll box. */
    position: relative;
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(var(--space-5), 2.2vw, var(--space-6));
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  .bcard__tags,
  .bcard__meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tag {
    padding: 2px var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-size: var(--text-caption);
    color: var(--ink-muted);
  }

  /* Domain tag: the bounty's highlight badge, in amber so robotics / space /
     AI agents reads first. Amber is for highlights only; text is --accent-ink. */
  .tag--domain {
    border-color: var(--accent-tint);
    background: var(--accent-tint);
    color: var(--accent-ink);
    font-weight: 600;
  }

  .bcard__repo {
    margin-top: var(--space-4);
    font-family: var(--font-code);
    font-size: var(--text-caption);
    color: var(--ink-muted);
  }

  .bcard__title {
    margin-top: var(--space-2);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
  }

  /* Two lines max; the full text stays in the HTML for screen readers. */
  .bcard__desc {
    margin-top: var(--space-2);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: var(--text-small);
    line-height: var(--leading-normal);
    color: var(--ink-muted);
  }

  .bcard__meta {
    margin-top: var(--space-4);
    gap: var(--space-4);
    font-size: var(--text-small);
    color: var(--ink);
  }

